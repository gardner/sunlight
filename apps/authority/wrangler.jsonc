{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sunlight-authority",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "R2_BUCKET_NAME": "sunlight-request-artifacts",
    "R2_PRESIGN_EXPIRES_SECONDS": "900"
  },
  "routes": [
    {
      "pattern": "requests.sunlight.nz",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sunlight-requests",
      "database_id": "796835ba-d5e5-4ad2-a931-bdf7b3a2b7dc",
      "migrations_dir": "../../cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "sunlight-request-artifacts"
    }
  ]
}
