{
  "$schema": "https://www.getbifrost.ai/schema",
  "plugins": [],
  "providers": {
    "nvidia": {
      "keys": [
        {
          "name": "default",
          "value": "env.NVIDIA_API_KEY",
          "models": [
            "fast",
            "fast-nvidia",
            "regular",
            "regular-nvidia",
            "reasoning",
            "reasoning-nvidia",
            "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
            "nvidia/nemotron-3-super-120b-a12b",
            "deepseek-ai/deepseek-v4-pro"
          ],
          "weight": 1.0,
          "aliases": {
            "fast": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
            "fast-nvidia": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
            "regular": "nvidia/nemotron-3-super-120b-a12b",
            "regular-nvidia": "nvidia/nemotron-3-super-120b-a12b",
            "reasoning": "deepseek-ai/deepseek-v4-pro",
            "reasoning-nvidia": "deepseek-ai/deepseek-v4-pro"
          }
        }
      ],
      "network_config": {
        "base_url": "https://integrate.api.nvidia.com",
        "default_request_timeout_in_seconds": 300,
        "stream_idle_timeout_in_seconds": 300
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    },
    "openrouter": {
      "keys": [
        {
          "name": "default",
          "value": "env.OPENROUTER_API_KEY",
          "models": [
            "fast-openrouter",
            "regular-openrouter",
            "reasoning-openrouter",
            "nvidia/nemotron-3-nano-30b-a3b:free",
            "nvidia/nemotron-3-super-120b-a12b:free",
            "poolside/laguna-m.1:free"
          ],
          "weight": 1.0,
          "aliases": {
            "fast-openrouter": "nvidia/nemotron-3-nano-30b-a3b:free",
            "regular-openrouter": "nvidia/nemotron-3-super-120b-a12b:free",
            "reasoning-openrouter": "poolside/laguna-m.1:free"
          }
        }
      ],
      "network_config": {
        "extra_headers": {
          "HTTP-Referer": "https://bifrost.local",
          "X-Title": "Bifrost Gateway"
        },
        "default_request_timeout_in_seconds": 300,
        "stream_idle_timeout_in_seconds": 300
      }
    },
    "groq": {
      "keys": [
        {
          "name": "default",
          "value": "env.GROQ_API_KEY",
          "models": [
            "fast",
            "regular",
            "reasoning",
            "llama-3.1-8b-instant",
            "qwen/qwen3-32b",
            "openai/gpt-oss-120b"
          ],
          "weight": 1.0,
          "aliases": {
            "fast": "llama-3.1-8b-instant",
            "regular": "qwen/qwen3-32b",
            "reasoning": "openai/gpt-oss-120b"
          }
        }
      ],
      "network_config": {
        "base_url": "https://api.groq.com/openai",
        "default_request_timeout_in_seconds": 300,
        "stream_idle_timeout_in_seconds": 300
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    }
  },
  "governance": {
    "rate_limits": [
      {
        "id": "rl-nvidia",
        "request_max_limit": 2,
        "request_reset_duration": "3s"
      },
      {
        "id": "rl-openrouter-rpm",
        "request_max_limit": 20,
        "request_reset_duration": "1m"
      },
      {
        "id": "rl-openrouter-day",
        "request_max_limit": 1000,
        "request_reset_duration": "1d",
        "calendar_aligned": true
      },
      {
        "id": "rl-groq",
        "request_max_limit": 30,
        "request_reset_duration": "1m"
      }
    ],
    "providers": [
      {
        "name": "nvidia",
        "rate_limit_id": "rl-nvidia"
      },
      {
        "name": "openrouter",
        "rate_limit_id": "rl-openrouter-rpm"
      },
      {
        "name": "groq",
        "rate_limit_id": "rl-groq"
      }
    ],
    "virtual_keys": [
      {
        "id": "vk-bifrost",
        "name": "bifrost",
        "value": "env.BIFROST_API_KEY",
        "provider_configs": [
          {
            "provider": "openrouter",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "rate_limit_id": "rl-openrouter-day"
          },
          {
            "provider": "nvidia",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ]
          },
          {
            "provider": "groq",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ]
          }
        ]
      }
    ],
    "routing_rules": [
      {
        "id": "fast-lb",
        "name": "fast",
        "enabled": true,
        "cel_expression": "provider == 'nvidia' && model == 'fast'",
        "scope": "global",
        "priority": 1,
        "targets": [
          {
            "provider": "nvidia",
            "model": "fast",
            "weight": 0.5
          },
          {
            "provider": "openrouter",
            "model": "fast-openrouter",
            "weight": 0.5
          }
        ],
        "fallbacks": [
          "openrouter/fast-openrouter",
          "nvidia/fast"
        ]
      },
      {
        "id": "regular-lb",
        "name": "regular",
        "enabled": true,
        "cel_expression": "provider == 'nvidia' && model == 'regular'",
        "scope": "global",
        "priority": 2,
        "targets": [
          {
            "provider": "nvidia",
            "model": "regular",
            "weight": 0.5
          },
          {
            "provider": "openrouter",
            "model": "regular-openrouter",
            "weight": 0.5
          }
        ],
        "fallbacks": [
          "openrouter/regular-openrouter",
          "nvidia/regular"
        ]
      },
      {
        "id": "reasoning-lb",
        "name": "reasoning",
        "enabled": true,
        "cel_expression": "provider == 'nvidia' && model == 'reasoning'",
        "scope": "global",
        "priority": 3,
        "targets": [
          {
            "provider": "nvidia",
            "model": "reasoning",
            "weight": 0.5
          },
          {
            "provider": "openrouter",
            "model": "reasoning-openrouter",
            "weight": 0.5
          }
        ],
        "fallbacks": [
          "openrouter/reasoning-openrouter",
          "nvidia/reasoning"
        ]
      },
      {
        "id": "fast-groq-lb",
        "name": "fast",
        "enabled": true,
        "cel_expression": "provider == 'groq' && model == 'fast'",
        "scope": "global",
        "priority": 4,
        "targets": [
          {
            "provider": "groq",
            "model": "fast",
            "weight": 1.0
          }
        ],
        "fallbacks": []
      },
      {
        "id": "regular-groq-lb",
        "name": "regular",
        "enabled": true,
        "cel_expression": "provider == 'groq' && model == 'regular'",
        "scope": "global",
        "priority": 5,
        "targets": [
          {
            "provider": "groq",
            "model": "regular",
            "weight": 1.0
          }
        ],
        "fallbacks": []
      },
      {
        "id": "reasoning-groq-lb",
        "name": "reasoning",
        "enabled": true,
        "cel_expression": "provider == 'groq' && model == 'reasoning'",
        "scope": "global",
        "priority": 6,
        "targets": [
          {
            "provider": "groq",
            "model": "reasoning",
            "weight": 1.0
          }
        ],
        "fallbacks": []
      }
    ]
  }
}
